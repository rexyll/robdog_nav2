<?xml version="1.0"?>
<package format="3">
  <name>robodog_lite3_bridge</name>
  <version>0.1.0</version>
  <description>Read-only Lite3 ROS 2 topic contract monitor and synthetic state publisher for integration tests.</description>
  <maintainer email="maintainers@example.invalid">RobDog Nav2 maintainers</maintainer>
  <license>UNSPECIFIED</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
